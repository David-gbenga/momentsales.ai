# momentsales.ai — monorepo .gitignore
# Stack: Python 3.12 / FastAPI (apps/api, apps/worker), React + TS / Vite (apps/web),
# pnpm workspaces (packages/shared), Docker, Terraform (infra/).
# Lockfiles (pnpm-lock.yaml, uv.lock, poetry.lock, .terraform.lock.hcl) ARE committed.

# ---------------------------------------------------------------------------
# Secrets & environment — never commit (.env.example IS committed)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
!*.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
.secrets/
service-account*.json
credentials*.json

# ---------------------------------------------------------------------------
# Python (apps/api, apps/worker)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
wheels/
pip-wheel-metadata/
.installed.cfg

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Tooling caches
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytest_cache/
.hypothesis/
.tox/
.nox/
.pyre/
.pytype/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
nosetests.xml

# ---------------------------------------------------------------------------
# Node / frontend (apps/web, packages/shared)
# ---------------------------------------------------------------------------
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.yarn/
*.tsbuildinfo
.eslintcache
.stylelintcache

# Build output
apps/web/dist/
packages/*/dist/
.vite/
.turbo/
.next/
out/
storybook-static/

# Tests (Vitest / Playwright)
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright/.auth/
vitest.config.*.timestamp-*
vite.config.*.timestamp-*

# ---------------------------------------------------------------------------
# Local data, uploads, Docker volumes
# ---------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
# Root-anchored so source dirs like apps/api/src/data/ are not ignored
/data/
.data/
/uploads/
/tmp/
.tmp/
docker-compose.override.yml
.docker/

# ---------------------------------------------------------------------------
# Terraform (infra/)
# ---------------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
logs/
*.log

# ---------------------------------------------------------------------------
# Editors & OS
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ---------------------------------------------------------------------------
# Claude Code — keep shared project config, ignore personal/local files
# ---------------------------------------------------------------------------
.claude/settings.local.json
CLAUDE.local.md

# ---------------------------------------------------------------------------
# Local one-off scripts
# ---------------------------------------------------------------------------
/node-check.ps1
/node-check2.ps1
