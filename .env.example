# momentsales.ai — environment template
# Copy to .env for local development:  cp .env.example .env
# Every key the apps read is listed here with a comment. Never commit .env.
# The local defaults below are for docker compose on your own machine only.
# Non-local environments refuse to start with any "change-me" value.

# --- Runtime -----------------------------------------------------------------
# local | test | staging | production
ENV=local
# debug | info | warning | error
LOG_LEVEL=info
# Public URL of the web app (used in emails and OAuth redirects)
WEB_BASE_URL=http://localhost:3000
# Where the Next.js server forwards /api/* (host-run dev). Compose overrides to http://api:8000
API_INTERNAL_URL=http://localhost:8000
# Host ports for the compose api and web containers
API_PORT=8000
WEB_PORT=3000
# Send cookies with the Secure flag. Must be true outside local http development.
COOKIE_SECURE=false

# --- Postgres ----------------------------------------------------------------
# Host port for the compose Postgres container
POSTGRES_PORT=5432
# Bootstrap superuser password for the Postgres container (local only)
POSTGRES_PASSWORD=change-me-postgres
# Schema owner; runs Alembic migrations (ADR-0004)
APP_OWNER_PASSWORD=change-me-owner
# Runtime role used by api and worker; row-level security always applies to it
APP_RW_PASSWORD=change-me-rw
# Runtime connection (app_rw). Compose rewrites the host to "postgres".
DATABASE_URL=postgresql+psycopg://app_rw:change-me-rw@localhost:5432/momentsales
# Migration connection (app_owner)
MIGRATION_DATABASE_URL=postgresql+psycopg://app_owner:change-me-owner@localhost:5432/momentsales
# Test databases used by pytest (dropped and re-migrated per test session)
TEST_DATABASE_URL=postgresql+psycopg://app_rw:change-me-rw@localhost:5432/momentsales_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://app_owner:change-me-owner@localhost:5432/momentsales_test

# --- Redis -------------------------------------------------------------------
# Host port for the compose Redis container
REDIS_PORT=6379
# Celery broker, rate limits, flag cache, dev email outbox
REDIS_URL=redis://localhost:6379/0
# Separate Redis DB for tests
TEST_REDIS_URL=redis://localhost:6379/15

# --- Auth & secrets (generate real values outside local) ---------------------
# HS256 signing key for access tokens. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-jwt-secret-at-least-32-characters-long
# HMAC key for signed links (waitlist unsubscribe, OAuth state) and IP hashing
SIGNING_SECRET=change-me-signing-secret-at-least-32-characters
# Fernet key that encrypts TOTP secrets at rest. Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=xb5Yb0bcm4o0r9bK0wQ1Zc5i8iX0b2S3dE4fG5hI6jY=
# Access token lifetime (seconds)
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime (days)
REFRESH_TOKEN_TTL_DAYS=30
# Magic-link lifetime (minutes)
MAGIC_LINK_TTL_MINUTES=15
# Workspace invitation lifetime (days)
INVITATION_TTL_DAYS=7
# Turn Redis rate limiting on/off (keep on outside tests)
RATE_LIMIT_ENABLED=true

# --- Providers (FR-15) -------------------------------------------------------
# mock = no network calls, no paid keys (default). live = use the adapters below.
PROVIDER_MODE=mock
# Email: primary and secondary adapter (resend | postmark); failover auto | manual
PROVIDER_EMAIL=resend
PROVIDER_EMAIL_SECONDARY=postmark
PROVIDER_EMAIL_FAILOVER=auto
# Identity provider for "Continue with Google" (google). Mock IdP is used when PROVIDER_MODE=mock.
PROVIDER_IDENTITY=google
# Sender address for transactional email
EMAIL_FROM=momentsales.ai <hello@momentsales.ai>
# Resend API key (live email, primary)
RESEND_API_KEY=
# Postmark server token and message stream (live email, secondary)
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
# Google OAuth client (create in Google Cloud console, testing mode). Redirect URI:
#   ${WEB_BASE_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payments: Stripe Connect (ADR-0011). TEST MODE ONLY -----------------------
# Live keys (sk_live_/rk_live_/pk_live_) are refused at startup.
PROVIDER_PAYMENTS=stripe
# Test-mode secret key (sk_test_...); only used when PROVIDER_MODE=live
STRIPE_SECRET_KEY=
# Test-mode publishable key (pk_test_...)
STRIPE_PUBLISHABLE_KEY=
# Signing secret of the "Your account" webhook endpoint (/api/v1/webhooks/stripe).
# With the Stripe CLI: `stripe listen --forward-to ...` prints it. Mock default below.
STRIPE_WEBHOOK_SECRET=whsec_mock_platform_secret
# Signing secret of the "Connected accounts" endpoint (/api/v1/webhooks/stripe-connect)
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_mock_connect_secret

# --- SaaS billing: Stripe Billing (FR-10, ADR-0015/0016). TEST MODE ONLY -------
# Uses STRIPE_SECRET_KEY above. Create the catalogue with:
#   uv run python -m momentsales.tools.stripe_billing_seed
# Billing events arrive on the platform endpoint (/api/v1/webhooks/stripe).
# Free trial: card required, Growth features, capped research runs
TRIAL_DAYS=14
TRIAL_RUNS=3
TRIAL_LIVE_LISTINGS=5
TRIAL_PLAN_CODE=growth
# Stripe Tax on SaaS invoices (add tax registrations in Stripe first)
STRIPE_TAX_ENABLED=false
# Customer Portal configuration printed by the billing seed (blank = Stripe's default)
STRIPE_PORTAL_CONFIGURATION_ID=
# Unit-economics guard: monthly price must exceed runs x cap x 3 (£1.00 per run).
# Only prices in the same currency as the cap are checked (no exchange rate is assumed).
RUN_COST_CAP_MINOR=100
RUN_COST_CAP_CURRENCY=GBP
# Platform fee on seller sales for workspaces with no active plan (pay-per-report), in
# basis points (200 = 2%). Plans set their own rate in the plans table (ADR-0017).
PLATFORM_FEE_BPS_NO_PLAN=200
# Dunning: past_due -> suspended after this many days
SUSPEND_AFTER_DAYS=30

# --- Research (Phase 2, ADR-0018) ----------------------------------------------
# Public holidays for the season engine (Nager.Date v4, no key needed)
PROVIDER_HOLIDAYS=nager
NAGER_BASE_URL=https://nagerholidays.com/api/v4
# Delivery days assumed for act-by dates until a supplier is matched (shown as an assumption)
RESEARCH_ASSUMED_DELIVERY_DAYS=5
# Runs stuck in queued/running longer than this are resumed by the sweeper
RESEARCH_STUCK_AFTER_MINUTES=10

# Market data (Phase 2b, ADR-0019; docs/integrations/dataforseo.md, serpapi.md).
# Live mode waits for both providers to confirm their terms in writing.
PROVIDER_MARKET_DATA=dataforseo
PROVIDER_MARKET_DATA_SECONDARY=serpapi
PROVIDER_MARKET_DATA_FAILOVER=auto
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_BASE_URL=https://api.dataforseo.com/v3
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com
# Per-call cost estimates in GBP micros (1,000,000 = £1), for the run cost cap only.
COST_DATAFORSEO_TRENDS_MICROS=9000
COST_DATAFORSEO_SERP_MICROS=2000
COST_SERPAPI_SEARCH_MICROS=20000
# Platform-wide paid market-data spend per month (£40); past it, runs use the cache only.
MARKET_DATA_MONTHLY_BUDGET_MICROS=40000000
# Shared market-data cache reuse window in hours (owner decision: 24).
MARKET_CACHE_MAX_AGE_HOURS=24
RESEARCH_MAX_ANCHORS=4
RESEARCH_MAX_CANDIDATES=20
RESEARCH_MARKETPLACE_TOP_N=12
RESEARCH_GROWTH_RECENT_WEEKS=3
RESEARCH_GROWTH_BASELINE_WEEKS=6
RESEARCH_PEAK_RATIO=0.9
RESEARCH_MIN_INTEREST=5
# Competition score weights (JSON); a missing part is dropped and the rest rescaled.
RESEARCH_COMPETITION_WEIGHTS={"results":0.25,"ads":0.35,"merchants":0.2,"spread":0.2}

# --- Receipt OCR (ADR-0014) ----------------------------------------------------
# claude | textract (primary and secondary); failover auto | manual
PROVIDER_OCR=claude
PROVIDER_OCR_SECONDARY=textract
PROVIDER_OCR_FAILOVER=auto
# Claude vision (primary OCR)
ANTHROPIC_API_KEY=
OCR_CLAUDE_MODEL=claude-haiku-5-5
# AWS credentials for Textract OCR only (storage has its own S3_* settings below)
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- File storage (ADR-0012) ---------------------------------------------------
# local (development only) | s3 (S3 or Cloudflare R2)
STORAGE_BACKEND=local
# Folder for the local backend (compose mounts a volume at /data/storage)
STORAGE_LOCAL_PATH=./data/storage
# S3 bucket, and the R2 endpoint (https://<ACCOUNT_ID>.r2.cloudflarestorage.com) if using R2
S3_BUCKET=
S3_ENDPOINT_URL=
# Storage credentials (an R2 API token, or AWS keys). Region "auto" for R2.
# If the keys are empty, boto3's default credential chain is used.
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Lifetime of signed download links (seconds)
SIGNED_URL_TTL_SECONDS=300
# Largest receipt upload (bytes, max 10 MB)
RECEIPT_MAX_BYTES=10485760

# --- Background jobs -----------------------------------------------------------
# celery (worker) | inline (tests only)
JOBS_MODE=celery

# --- Web (Next.js) -----------------------------------------------------------
# Shown in the UI to explain that providers are mocked
NEXT_PUBLIC_PROVIDER_MODE=mock
